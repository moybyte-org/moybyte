+// The kind a mark on box b is (KK_*): a card by its class, a row three times
+// as wide as tall or one marked beside (`side`), else a cell.
+static int km_kind(moy_ui_box_t b, int cls, int flags) {
+    if (cls == MOY_UI_MARK_CARD) {
+        return KK_CARD;
+    }
+    if (flags & MOY_UI_MARK_CELL) {
+        return KK_CELL;
+    }
+    return (flags & MOY_UI_MARK_SIDE) || b.w >= 3 * b.h ? KK_ROW : KK_CELL;
+}
+
+// The ink over a mark's colour token `ci`: the selection's own ink over the
+// selection, else black or white, the one that clears it.
+static int km_ink(const dd_t *d, int ci) {
+    if (ci == moy_ui_token(d->look, MOY_UI_T_SELECTION)) {
+        return moy_ui_token(d->look, MOY_UI_T_SELECTION_INK);
+    }
+    return ink_over(d, ci);
+}
+
+// Mark `k` on box (x, y, w, h) of radius r at font scale f; `under` the token
+// of the fill it lands on (-1: none), whose ink an undeclared colour takes.
+// The ink the content takes on it, or -1.
+static int km_draw(const dd_t *d, const kmark_t *k, int x, int y, int w, int h, int r, int f,
+                   int under, int alpha) {
+    int ci = k->c >= 0 ? moy_ui_token(d->look, k->c)
+             : under >= 0 ? km_ink(d, under) : moy_ui_token(d->look, MOY_UI_T_ACCENT);
+    uint16_t c = d->row->pal[moy_ui_pidx(ci)];
+    int t = k->w * f, g = k->gap * f, kw = k->key_w * f;
+    uint16_t kc = kw > 0 && set(k->key_c) ? val(d, k->key_c) : 0;
+    int bx = x, by = y, bw = w, bh = h, br = r;       // the shape a keyline rings
+    int ink = -1;
+    switch (k->mark) {
+        case KM_FILL:
+            if (alpha >= 255 && r > 0 && s_corners != 15) {
+                moy_shape_paint_t p = solid(c);
+                rrect(d, x, y, w, h, r, s_corners, s_depth.stepped, MOY_SHAPE_ALL, &p, 0, 0, -1,
+                      NULL);
+            } else {
+                tint(d, x, y, w, h, r, c, alpha, NULL);
+            }
+            ink = alpha >= 255 ? km_ink(d, ci) : -1;
+            break;
+        case KM_TINT:
+            tint(d, x, y, w, h, r, c, k->alpha * alpha / 255, NULL);
+            break;
+        case KM_BAR: {
+            int in = h > 8 * f ? 2 * f : 0;
+            bx = x + g, by = y + in, bw = t, bh = h - 2 * in, br = 0;
+            tint(d, bx, by, bw, bh, 0, c, alpha, NULL);
+            break;
+        }
+        case KM_RING: {
+            int o = g + t;
+            bx = x - o, by = y - o, bw = w + 2 * o, bh = h + 2 * o, br = r ? r + o : 0;
+            ring_a(d, bx, by, bw, bh, br, t, c, alpha);
+            break;
+        }
+        case KM_INSET:
+        case KM_OUTLINE: {
+            int o = k->mark == KM_INSET ? g : 0;
+            bx = x + o, by = y + o, bw = w - 2 * o, bh = h - 2 * o, br = r > o ? r - o : 0;
+            ring_a(d, bx, by, bw, bh, br, t, c, alpha);
+            break;
+        }
+        case KM_UNDERLINE:
+            bx = x + g, by = y + h - t - f, bw = w - 2 * g, bh = t, br = 0;
+            tint(d, bx, by, bw, bh, 0, c, alpha, NULL);
+            break;
+        default:
+            return -1;
+    }
+    if (kw > 0 && set(k->key_c)) {
+        if (k->mark == KM_INSET || k->mark == KM_OUTLINE || k->mark == KM_FILL
+            || k->mark == KM_TINT) {
+            // a line or a fill keys inside its own edge, never over a neighbour
+            int e = k->mark == KM_FILL || k->mark == KM_TINT ? 0 : t;
+            ring_a(d, bx + e, by + e, bw - 2 * e, bh - 2 * e, br > e ? br - e : 0, kw, kc, alpha);
+        } else {
+            ring_a(d, bx - kw, by - kw, bw + 2 * kw, bh + 2 * kw, br ? br + kw : 0, kw, kc,
+                   alpha);
+        }
+    }
+    return ink;
+}
