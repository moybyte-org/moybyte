+// A theme's declared mark per item kind and state (`marks.<kind>.<state>`):
+// `mark` one of KM_*, -1 where the look declares none (the older keys draw).
+enum { KM_NONE = 0, KM_FILL, KM_TINT, KM_BAR, KM_RING, KM_INSET, KM_OUTLINE, KM_UNDERLINE };
+enum { KK_ROW = 0, KK_CELL = 1, KK_CARD = 2 };
+enum { KS_FOCUS = 0, KS_ON = 1, KS_BOTH = 2 };
+typedef struct {
+    int8_t mark, w, gap, key_w;
+    int16_t c;
+    uint8_t alpha;
+    int32_t key_c;
+} kmark_t;
+static kmark_t s_km[3][3];
+static moy_ui_box_t s_on_box;      // the box the last on mark was drawn on
+static int s_on_ci = -1;           // its fill's colour token (-1: no fill)
+static int s_corners = 15;         // the corners a row's fill rounds
+
+static int s_danger = -1;          // the danger ink of the row being focused
+
+// A danger row's ink (-1: none) for the focus mark about to be drawn: a fill
+// it would not clear 4.5:1 on gives way to an inset line, the ink kept.
+void moy_ui_kmark_danger(int ink) {
+    s_danger = ink;
+}
+
+int moy_ui_kmark_declared(int kind, int state) {
+    return s_km[kind][state].mark >= 0;
+}
+
+static void kmarks_of(const moy_theme_look_t *lk) {
+    static const char *const kinds[3] = {"row", "cell", "card"};
+    static const char *const states[3] = {"focus", "on", "both"};
+    char n[40];
+    for (int k = 0; k < 3; k++) {
+        for (int st = 0; st < 3; st++) {
+            kmark_t *km = &s_km[k][st];
+            snprintf(n, sizeof(n), "marks.%s.%s.mark", kinds[k], states[st]);
+            km->mark = (int8_t)num(leaf(lk, n), -1);
+            snprintf(n, sizeof(n), "marks.%s.%s.c", kinds[k], states[st]);
+            km->c = num(leaf(lk, n), -1);
+            snprintf(n, sizeof(n), "marks.%s.%s.w", kinds[k], states[st]);
+            km->w = (int8_t)num(leaf(lk, n), 2);
+            snprintf(n, sizeof(n), "marks.%s.%s.gap", kinds[k], states[st]);
+            km->gap = (int8_t)num(leaf(lk, n), 0);
+            snprintf(n, sizeof(n), "marks.%s.%s.alpha", kinds[k], states[st]);
+            km->alpha = alpha_of(lk, n, 100);
+            snprintf(n, sizeof(n), "marks.%s.%s.key.w", kinds[k], states[st]);
+            km->key_w = (int8_t)whole(lk, n, 0);
+            snprintf(n, sizeof(n), "marks.%s.%s.key.c", kinds[k], states[st]);
+            km->key_c = leaf(lk, n);
+        }
+    }
+}
