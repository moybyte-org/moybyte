# The upstream releases every build compiles against, named once.
#
# KEY=value lines, no quotes and no spaces: tools/esp32_build_lib.sh and the
# web runner's build.sh source this file, the Makefile includes it, CI reads
# it into step outputs and cache keys, and tools/upstream_pins.py reads it for
# Python. tests/test_upstream_pins.py fails a build script or workflow that
# spells a release itself.
#
# MOYBYTE_MPY_TAG  mainline MicroPython, every board's and the web runner's
#                  (MPY_TAG in the environment overrides it for one build)
# MOYBYTE_IDF_VER  ESP-IDF, every board's; a checkout at another release
#                  stops the build (moybyte_resolve_idf)
MOYBYTE_MPY_TAG=v1.28.0
MOYBYTE_IDF_VER=v5.5.6
