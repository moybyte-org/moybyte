{
  "format": "kidcode-cart-v1",
  "title": "Star Catcher",
  "type": "game",
  "runtime": "python",
  "main": "main.py",
  "system": true,
  "canvas": { "width": 480, "height": 270, "palette": "kid64" },
  "permissions": ["graphics", "input"],
  "safe_to_share": true,
  "config": {
    "star_count": 5,
    "fall_speed": 70,
    "basket": "frog"
  },
  "edit": [
    { "key": "star_count", "label": "STARS", "type": "int", "min": 1, "max": 20, "step": 1, "card": "DROP {value} STARS" },
    { "key": "fall_speed", "label": "SPEED", "type": "int", "min": 20, "max": 200, "step": 10, "card": "STARS FALL AT {value}" },
    { "key": "basket", "label": "CATCHER", "type": "choice", "choices": ["frog", "robot"], "card": "CATCHER IS A {value}" }
  ]
}
