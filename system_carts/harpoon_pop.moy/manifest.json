{
  "format": "moy-1",
  "version": 7,
  "title": "Harpoon Pop",
  "type": "game",
  "runtime": "python",
  "main": "main.py",
  "system": true,
  "order": 200,
  "canvas": "320x240",
  "permissions": [
    "graphics",
    "input",
    "multiplayer"
  ],
  "safe_to_share": true,
  "config": {
    "start_bubbles": 2,
    "bubble_speed": 100,
    "harpoon_speed": 300,
    "lives": 3,
    "autoplay": 0
  },
  "edit": [
    {
      "key": "start_bubbles",
      "label": "BUBBLES",
      "type": "int",
      "min": 1,
      "max": 4,
      "step": 1,
      "display": "count",
      "icon": "dot",
      "card": "START WITH {value} BUBBLES"
    },
    {
      "key": "bubble_speed",
      "label": "SPEED",
      "type": "int",
      "min": 50,
      "max": 200,
      "step": 10,
      "display": "gauge",
      "gauge": {
        "low": "turtle",
        "high": "rabbit"
      },
      "card": "BUBBLES DRIFT AT {value}"
    },
    {
      "key": "harpoon_speed",
      "label": "HARPOON",
      "type": "int",
      "min": 150,
      "max": 500,
      "step": 25,
      "display": "gauge",
      "gauge": {
        "low": "turtle",
        "high": "rabbit"
      },
      "card": "HARPOON FLIES AT {value}"
    },
    {
      "key": "lives",
      "label": "LIVES",
      "type": "int",
      "min": 1,
      "max": 5,
      "step": 1,
      "display": "count",
      "icon": "heart",
      "card": "{value} LIVES"
    },
    {
      "key": "autoplay",
      "label": "AUTOPLAY",
      "type": "choice",
      "choices": [
        0,
        1
      ],
      "icons": [
        "close",
        "run"
      ],
      "display": "choice-icons",
      "card": "AUTOPLAY {value}"
    }
  ]
}
