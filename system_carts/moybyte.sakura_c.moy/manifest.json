{
  "format": "moy-1",
  "version": 1,
  "title": "Sakura C",
  "id": "moybyte.sakura_c",
  "runtime": "wasm",
  "main": "main.wasm",
  "memory": 2,
  "canvas": "320x240",
  "extensions": [
    "moybyte.images",
    "moybyte.scenes"
  ],
  "description": "Cherry blossoms drifting down a hillside, written in C: one source, built to wasm and to a native module per chip.",
  "genre": "toy",
  "moybyte": {
    "type": "wallpaper",
    "system": true,
    "seed": false,
    "order": 135,
    "native": [],
    "permissions": [
      "graphics",
      "input"
    ],
    "config": {
      "petal_count": 120,
      "fall_speed": 30,
      "breeze": 18,
      "blossom": "pink"
    },
    "edit": [
      {
        "key": "petal_count",
        "label": "PETALS",
        "type": "int",
        "min": 20,
        "max": 200,
        "step": 10,
        "card": "SHED {value} BLOSSOMS FROM THE TREE"
      },
      {
        "key": "fall_speed",
        "label": "FALL",
        "type": "int",
        "min": 10,
        "max": 70,
        "step": 5,
        "display": "gauge",
        "gauge": {
          "low": "turtle",
          "high": "rabbit"
        },
        "card": "PETALS FALL AT {value}"
      },
      {
        "key": "breeze",
        "label": "BREEZE",
        "type": "int",
        "min": 0,
        "max": 50,
        "step": 5,
        "card": "THE BREEZE BLOWS AT {value}"
      },
      {
        "key": "blossom",
        "label": "BLOSSOM",
        "type": "choice",
        "choices": [
          "pink",
          "white",
          "peach",
          "mixed"
        ],
        "card": "BLOSSOMS ARE {value}"
      }
    ],
    "assets": {
      "scenes": [
        "blossoms"
      ]
    }
  }
}
