{
  "format": "kidcode-cart-v1",
  "title": "Space Desktop",
  "type": "wallpaper",
  "runtime": "python",
  "main": "main.py",
  "system": true,
  "canvas": { "width": 480, "height": 270, "palette": "kid64" },
  "permissions": ["graphics", "input"],
  "age_mode": "cards",
  "safe_to_share": true,
  "config": {
    "star_count": 80,
    "star_speed": 30,
    "bg": "dark_blue",
    "pet": "frog"
  },
  "edit": [
    { "key": "star_count", "label": "STARS", "type": "int", "min": 10, "max": 300, "step": 10, "card": "ADD {value} STARS" },
    { "key": "star_speed", "label": "SPEED", "type": "int", "min": 5, "max": 90, "step": 5, "card": "SKY MOVES AT {value}" },
    { "key": "pet", "label": "PET", "type": "choice", "choices": ["frog", "robot"], "card": "PET IS A {value}" },
    { "key": "bg", "label": "BG", "type": "choice", "choices": ["dark_blue", "dark_purple", "black", "indigo"], "card": "SKY IS {value}" }
  ]
}
