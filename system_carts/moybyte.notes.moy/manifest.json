{
  "format": "moy-1",
  "version": 12,
  "title": "Notes",
  "id": "moybyte.notes",
  "runtime": "python",
  "main": "main.py",
  "canvas": "320x240",
  "moybyte": {
    "type": "app",
    "system": true,
    "order": 350,
    "targets": [
      "host",
      "device",
      "web"
    ],
    "permissions": [
      "graphics",
      "input",
      "files:docs",
      "clipboard",
      "prefs",
      "editor"
    ],
    "handles": [
      "text/markdown",
      "text/plain",
      "application/json",
      "text/x-python",
      "text/x-lua"
    ],
    "config": {},
    "edit": []
  }
}
