{
  "format": "moy-1",
  "version": 4,
  "title": "Notes",
  "id": "moybyte.notes",
  "runtime": "python",
  "main": "main.py",
  "canvas": "320x240",
  "moybyte": {
    "type": "app",
    "system": true,
    "order": 350,
    "targets": [
      "host",
      "device"
    ],
    "permissions": [
      "graphics",
      "input",
      "files:docs",
      "clipboard",
      "prefs",
      "editor"
    ],
    "safe_to_share": true,
    "config": {},
    "edit": []
  }
}
