{
  "format": "moy-1",
  "version": 4,
  "title": "Pin Light",
  "id": "moybyte.pin_light",
  "runtime": "python",
  "main": "main.py",
  "canvas": "320x240",
  "moybyte": {
    "type": "game",
    "system": true,
    "order": 360,
    "permissions": [
      "graphics",
      "input",
      "pins"
    ],
    "safe_to_share": true,
    "config": {
      "pin": 21
    },
    "edit": [
      {
        "key": "pin",
        "label": "PIN",
        "type": "int",
        "min": 1,
        "max": 21,
        "card": "DRIVES PIN {value}"
      }
    ]
  }
}
