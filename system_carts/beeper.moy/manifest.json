{
  "format": "moybyte-cart-v1",
  "version": 1,
  "title": "Beeper",
  "type": "app",
  "runtime": "python",
  "main": "main.py",
  "system": true,
  "canvas": { "width": 320, "height": 240, "palette": "moy64" },
  "permissions": ["graphics", "input", "sound"],
  "safe_to_share": true,
  "config": {
    "music_on": 1
  },
  "edit": [
    { "key": "music_on", "label": "MUSIC", "type": "choice", "choices": [0, 1], "card": "MUSIC IS {value}" }
  ]
}
