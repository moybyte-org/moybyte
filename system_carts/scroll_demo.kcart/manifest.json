{
  "format": "kidcode-cart-v1",
  "version": 1,
  "title": "Scroll Demo",
  "type": "game",
  "runtime": "python",
  "main": "main.py",
  "system": true,
  "canvas": { "width": 320, "height": 240, "palette": "kid64" },
  "permissions": ["graphics", "input"],
  "safe_to_share": true,
  "config": {
    "world": 2,
    "speed": 60,
    "mode": "auto"
  },
  "edit": [
    { "key": "world", "label": "WORLD", "type": "int", "min": 2, "max": 4, "step": 1, "card": "WORLD {value}x SCREEN" },
    { "key": "speed", "label": "SPEED", "type": "int", "min": 20, "max": 140, "step": 10, "card": "DRIFT {value}" },
    { "key": "mode", "label": "MODE", "type": "choice", "choices": ["auto", "drive"], "card": "MODE {value}" }
  ]
}
