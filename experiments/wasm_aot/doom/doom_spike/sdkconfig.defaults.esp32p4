# ESP32-P4 (Waveshare 7B) on top of sdkconfig.defaults: the console's own
# clock, L2 cache and PSRAM (firmware/esp32_p4_wifi6_touch_lcd_7b), the CH343
# UART console, 32 MB flash. The S3-only symbols in the base file do not exist
# here and are ignored. Headless: no panel, no input.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set
CONFIG_ESP_SYSTEM_PMP_IDRAM_SPLIT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=
CONFIG_ESP_CONSOLE_SECONDARY_NONE=
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
