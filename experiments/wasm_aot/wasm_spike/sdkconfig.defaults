# match the console build so the number is comparable to the Lua run
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
# WAMR: fast interpreter, no AOT (no wamrc for riscv32 yet)
CONFIG_WAMR_ENABLE_INTERP=y
CONFIG_WAMR_INTERP_FAST=y
CONFIG_WAMR_ENABLE_LIBC_BUILTIN=y
# CONFIG_ESP_SYSTEM_MEMPROT_FEATURE is not set
# CONFIG_WAMR_ENABLE_LIBC_WASI is not set
CONFIG_WAMR_ENABLE_AOT=y
# CONFIG_WAMR_ENABLE_LIB_PTHREAD is not set
CONFIG_WAMR_ENABLE_REF_TYPES=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_spike.csv"
