{
  "moy_ui": {
    "about": "the toolkit's C, native/moy_ui",
    "host": "moy_ui_binding",
    "binding": true,
    "structs": [
      "moy_ui_box_t", "moy_ui_surface_t", "moy_ui_shape_t", "moy_theme_bar_t",
      "moy_theme_layout_t", "moy_ui_span_t", "moy_ui_lines_t", "moy_ui_depth_t",
      "moy_ui_frame_button_t", "moy_ui_sink_t", "moy_ui_row_t", "moy_ui_cell_t", "moy_ui_button_t",
      "moy_ui_btn_style_t", "moy_ui_over_t", "moy_ui_mark_t", "moy_theme_cell_t",
      "moy_theme_paint_t", "moy_theme_mapent_t", "moy_theme_look_t", "moy_theme_leaf_t"
    ],
    "api": [
      {"api": "size"},
      {"api": "begin", "hand": true},
      {"api": "page", "run": "draw"},
      {"api": "label", "hand": ["mp"], "run": "draw"},
      {"api": "button", "ret": "bool", "run": "draw"},
      {"api": "toggle", "flag": ["on"], "ret": "bool", "run": "draw"},
      {"api": "group", "run": "draw"},
      {"api": "value", "ret": "bool", "run": "draw", "doc": "`kind` MOY_UI_V_INFO or MOY_UI_V_LINK (moy_ui.h); *out: activated."},
      {"api": "choice", "opts": ["opts"], "run": "draw", "doc": "`kind` MOY_UI_V_CYCLE, MOY_UI_V_SEG, MOY_UI_V_SWATCH or MOY_UI_V_TABS; *out: the new cur."},
      {"api": "hints", "opts": ["items"], "run": "draw"},
      {"api": "hints_w", "opts": ["items"]},
      {"api": "slider", "run": "draw"},
      {"api": "icon", "ret": "bool", "run": "draw"},
      {"api": "box", "out": {"out": 4}, "ret": "if"},
      {"api": "progress", "run": "draw"},
      {"api": "list", "opts": ["items"], "run": "draw"},
      {"api": "part", "out": {"out": 5}, "run": "draw"},
      {"api": "measure", "out": {"out": 5}, "doc": "The box the next call of a verb would take, drawing nothing (moy_ui_api_measure): x, y, w, h and the stack's step at out."},
      {"api": "space"},
      {"api": "dock", "out": {"out": 4}, "ret": "if", "doc": "The open page's last h pixels a docked foot's, cut from its room on its ground (moy_ui_api_dock): its box at out, else 0."},
      {"api": "part_at", "out": {"out": 2}, "ret": "if", "run": "query:0", "doc": "Where the pointer is inside the part answered last (moy_ui_api_part_at): 1 with x, y at out, else 0."},
      {"api": "split", "hand": true, "run": "draw", "run_ret": "cur", "doc": "The panes (moy_ui_api_split): the focused pane at *cur, the panes' rects and the drag's words at out, a divider let go after a drag writing `sizes`."},
      {"api": "split_at", "ret": "bool"},
      {"api": "split_frame", "hand": true},
      {"api": "split_toward", "buf": {"out": 4}, "ret": "bool"},
      {"api": "grid", "run": "draw"},
      {"api": "card", "out": {"out": 5}, "run": "draw"},
      {"api": "table", "hand": true, "run": "draw"},
      {"api": "scroll", "ret": "nested_none", "run": "nest"},
      {"api": "field", "run": "draw"},
      {"api": "dialog", "opts": ["buttons"], "ret": "nested", "run": "deep"},
      {"api": "wash"},
      {"api": "wash_box"},
      {"api": "owes", "ret": "bool"},
      {"api": "moved", "ret": "bool"},
      {"api": "moving", "ret": "bool"},
      {"api": "busy", "hand": true},
      {"api": "offset"},
      {"api": "fades", "flag": ["reset"]},
      {"api": "owed", "flag": ["reset"]},
      {"api": "end"},
      {"api": "table_rows", "hand": true},
      {"api": "table_dist", "run": "query:0", "doc": "The part answered last's distance from its view's centre, in 256ths of a row (moy_ui_api_table_dist)."},
      {"api": "table_pics"},
      {"api": "table_part", "buf": {"out": 8}},
      {"api": "table_floor", "buf": {"out": 4}, "run": "query:0", "doc": "The next rect of the floor of the table drawn last (moy_ui_api_table_floor) at out: 1, then 0, -1 or -2 after the last."},
      {"api": "table_copy", "buf": {"out": 4}, "flag": ["back"]},
      {"api": "table_shift", "buf": {"out": 5}, "flag": ["back"]},
      {"api": "held", "trunc": ["key"], "ret": "bool", "run": "query:0", "doc": "Whether the buffer the frame paints holds part `id` under `key` (moy_ui_api_held)."},
      {"api": "held_last", "trunc": ["key"], "ret": "bool", "run": "query:0", "doc": "Whether the buffer the last frame painted holds part `id` under `key` (moy_ui_api_held_last), and whether every buffer holds every part the frame named (moy_ui_api_held_all)."},
      {"api": "held_all", "ret": "bool", "run": "query:0"},
      {"api": "slots", "trunc": ["cap", "key"], "run": "query:0", "doc": "The faces the table drawn last keeps (moy_ui_api_slots), the slot of one (moy_ui_api_slot) and the next part an idle frame draws the face of (moy_ui_api_slot_next)."},
      {"api": "slot", "trunc": ["gen"], "flag": ["mint"], "run": "query:-1"},
      {"api": "slot_next", "run": "query:-1"},
      {"api": "block_set", "trunc": ["value"], "ret": "bool"},
      {"api": "block_gen"},
      {"api": "block_since"},
      {"api": "block_key"},
      {"api": "popover", "ret": "nested", "run": "deep"},
      {"api": "menu", "opts": ["items", "icons"], "run": "draw"},
      {"api": "menu_danger"},
      {"api": "tool", "ret": "bool", "run": "draw"},
      {"api": "bar", "hand": true, "run": "draw"},
      {"api": "bar_lent", "hand": true},
      {"api": "bar_tap"},
      {"api": "back", "flag": ["take"], "ret": "bool"},
      {"api": "cancel", "flag": ["take"], "ret": "bool"},
      {"api": "run_cancel", "c": "moy_ui_run_cancel", "flag": ["take"], "ret": "bool"},
      {"api": "run_back", "c": "moy_ui_run_back", "flag": ["take"], "ret": "bool"},
      {"api": "run_bar_lent", "hand": true},
      {"api": "run_bar_tap", "c": "moy_ui_run_bar_tap"},
      {"api": "paste"},
      {"api": "run_paste", "c": "moy_ui_run_paste"},
      {"api": "run_steps", "c": "moy_ui_run_steps"},
      {"api": "run_typing", "c": "moy_ui_run_typing", "ret": "bool"},
      {"api": "rule", "run": "draw"},
      {"api": "text"},
      {"api": "card_mark"},
      {"api": "grid_spread", "dflt": {"wrap": "0"}},
      {"api": "group_card"},
      {"api": "empty", "opts": ["lines"], "run": "draw", "doc": "An empty page's head (moy_ui_api_empty): *out the y under it."},
      {"api": "note", "opts": ["lines"], "run": "draw", "doc": "A note on the page (moy_ui_api_note): *out the y under it."},
      {"api": "bubble", "wspan": ["opt"], "out": {"out": 5}, "run": "draw", "doc": "A chat's bubble (moy_ui_api_bubble): out its x, y, w, h and state."},
      {"api": "month"},
      {"api": "toast", "flag": ["flat"], "out": {"out": 4}},
      {"api": "focus", "hand": true},
      {"api": "focus_ahead"},
      {"api": "shift_plan", "buf": {"out": 8}},
      {"api": "shift_break"},
      {"api": "shift_drawn", "hand": true},
      {"api": "band", "hand": true},
      {"api": "floor_box", "buf": {"out": 4}, "ret": "bool"},
      {"api": "change_box", "buf": {"out": 8}, "ret": "bool"},
      {"api": "lag_note", "hand": true},
      {"api": "lag", "hand": true},
      {"api": "host_begin", "hand": true},
      {"api": "host_arm"},
      {"api": "host_whole"},
      {"api": "keys_back"},
      {"api": "pop_box", "buf": {"out": 4}, "ret": "bool"},
      {"api": "text_view", "hand": true, "run": "nest", "run_fix": {"marks": "NULL"}},
      {"api": "text_at", "out": {"out": 2}, "ret": "if"},
      {"api": "text_cover"},
      {"api": "text_aim", "ret": "bool"},
      {"api": "text_reveal", "hand": true},
      {"api": "card_clip", "hand": true},
      {"api": "keep"},
      {"api": "audit"},
      {"api": "keys_taken", "ret": "bool", "run": "query:0"},
      {"api": "typing", "ret": "bool"},
      {"api": "edge", "ret": "bool"},
      {"api": "tap_armed", "ret": "bool"},
      {"api": "at", "run": "query"},
      {"api": "dup"},
      {"api": "lost"}
    ]
  }
}
