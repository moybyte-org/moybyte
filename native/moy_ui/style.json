        ["focus", "accent"], ["title_active", "title"], ["title_inactive", "panel"],
        ["ink", 7], ["ink_dim", 6], ["chrome_ink", 7], ["chrome_ink_dim", 6],
        ["selection_ink", 7], ["bar", 0], ["bar_edge", 5], ["play", 11],
        ["author", 10], ["danger", 8],
        ["surface_light", false], ["bar_light", false], ["band_light", false],
        ["shade_hi", "hilite"], ["shade_lo", "dim"], ["shade_dark", 0],
        ["ink_accent", "accent"], ["ink_note", 15],
        ["block_events", 10], ["block_control", 9], ["block_actors", 12],
        ["block_looks", 2], ["block_draw", 3], ["block_input", 13],
