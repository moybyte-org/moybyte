{
  "format": 1,
  "name": "night",
  "frame": { "style": "classic" },
  "fonts": { "ui": "tiny5.fnt", "title": "tiny5.fnt" },
  "metrics": { "radius": 0, "press_dx": 0, "press_dy": 0 },
  "layout": {
    "bars": [
      { "edge": "top", "size": 18, "left": ["zone"], "center": ["chips"],
        "right": ["clock", "close", "menu", "wifi", "battery"] }
    ]
  },
  "colors": {
    "dark": {
      "panel": 60, "edge": 13, "title": 13, "title_ink": 0, "accent": 10,
      "hilite": 13, "dim": 1, "title_inactive": 54, "surface_alt": 51
    },
    "light": {
      "panel": 7, "edge": 0, "title": 13, "title_ink": 0, "accent": 12,
      "hilite": 22, "dim": 49, "desktop": 22, "desktop_pattern": 48,
      "border": 0, "surface_alt": 6, "title_inactive": 6
    }
  },
  "surfaces": {
    "button": { "rest": "fill surface_alt, border shade_dark, shadow",
                "hover": "fill surface_alt, border focus, shadow",
                "on": "border shade_dark, shadow",
                "pressed": "border shade_dark" },
    "button_play": { "rest": "border shade_dark, shadow", "pressed": "border shade_dark" },
    "button_author": { "rest": "border shade_dark, shadow", "pressed": "border shade_dark" },
    "button_danger": { "rest": "border shade_dark, shadow", "pressed": "border shade_dark" },
    "chip": { "rest": "border shade_dark" },
    "panel": { "rest": "border shade_dark" },
    "desk.icon": { "rest": "fill panel, border shade_dark, shadow" },
    "desk": { "rest": "fill bar" }
  }
}
