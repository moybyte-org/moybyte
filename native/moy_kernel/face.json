{
  "moy_log": {
    "about": "the OS log, native/moy_kernel/moy_log.h",
    "host": "moy_log",
    "headers": ["moy_log.h", "moy_proc_exit.h"],
    "consts": [
      "MOY_LOG_EMERG as EMERG", "MOY_LOG_ALERT as ALERT", "MOY_LOG_CRIT as CRIT",
      "MOY_LOG_ERR as ERR", "MOY_LOG_WARNING as WARNING", "MOY_LOG_NOTICE as NOTICE",
      "MOY_LOG_INFO as INFO", "MOY_LOG_DEBUG as DEBUG", "MOY_LOG_KERNEL as KERNEL",
      "MOY_LOG_SHELL as SHELL", "MOY_LOG_TEXT_MAX as TEXT_MAX", "MOY_PROC_NOT_RUN as NOT_RUN",
      "MOY_PROC_INTERRUPTED as INTERRUPTED", "MOY_PROC_TRAPPED as TRAPPED",
      "MOY_PROC_KILLED as KILLED"
    ],
    "structs": ["moy_log_rec_t", "moy_log_cursor_t"],
    "rows": [
      {"py": "write(level, pid, *parts)", "hand": true},
      {"py": "spawn(name)", "c": "moy_log_spawn", "example": ["face"]},
      {"py": "name(pid)", "c": "moy_log_name", "trunc": ["pid"], "example": [1]},
      {"py": "current(pid=None)", "hand": true},
      {"py": "read(seq=0, n=32)", "hand": true},
      {"py": "next()", "hand": true},
      {"py": "stats()", "c": "moy_log_stats", "out": {"s": ["first", "next", "used", "cap"]}, "example": []},
      {"py": "level_name(level)", "c": "moy_log_level_name", "example": [3]},
      {"py": "level_of(name)", "c": "moy_log_level_of", "span": ["name"], "noalloc": true, "example": ["warning"]},
      {"py": "init(bytes)", "c": "moy_log_init", "example": [4096]},
      {"py": "pin_clock(us)", "c": "moy_log_pin_clock", "example": [1000]}
    ]
  },
  "moy_lease": {
    "about": "the lease table, native/moy_kernel/moy_lease.h",
    "host": "moy_lease",
    "headers": ["moy_lease.h"],
    "consts": [
      "MOY_LEASE_WIFI as WIFI", "MOY_LEASE_GPIO as GPIO", "MOY_LEASE_UART as UART",
      "MOY_LEASE_SPI as SPI", "MOY_LEASE_VM as VM", "MOY_LEASE_PINS as PINS",
      "MOY_PIN_IN as PIN_IN", "MOY_PIN_OUT as PIN_OUT", "MOY_PIN_PU as PIN_PU",
      "MOY_PIN_PD as PIN_PD", "MOY_PIN_PERIPH as PIN_PERIPH", "MOY_PIN_SAFE as PIN_SAFE",
      "MOY_LEASE_ROWS_MAX as ROWS_MAX", "MOY_LEASE_EDGES as EDGES",
      "MOY_LEASE_PIN_MAX as PIN_MAX", "MOY_LEASE_SHELL as SHELL"
    ],
    "structs": ["moy_lease_offer_t", "moy_lease_row_t"],
    "errors": {"lease": {"codes": {"MOY_LEASE_STALE": "EBADF", "MOY_LEASE_FULL": "ENOSPC", "MOY_LEASE_NOMEM": "ENOMEM", "MOY_LEASE_BAD": "EINVAL", "MOY_LEASE_BUSY": "EBUSY"}, "other": "EIO"}},
    "rows": [
      {"py": "offer(spec)", "c": "moy_lease_offer", "null": ["spec"], "err": "lease", "example": ["gpio:0,1,2,3/uart1:4,5"]},
      {"py": "offers()", "hand": true},
      {"py": "take(owner, cls, unit, pins, flags=0)", "hand": true},
      {"py": "drop(h)", "c": "moy_lease_drop", "err": "lease", "example": [12345]},
      {"py": "sweep(owner)", "c": "moy_lease_sweep", "example": [7]},
      {"py": "vm_stop()", "c": "moy_lease_vm_stop", "example": []},
      {"py": "live(h)", "c": "moy_lease_live", "example": [12345]},
      {"py": "leases()", "hand": true},
      {"py": "get(h)", "hand": true},
      {"py": "held(flags=0)", "c": "moy_lease_held", "example": []},
      {"py": "of_pin(pin)", "c": "moy_lease_of_pin", "example": [1]},
      {"py": "edge(h, pin, depth, loop=False)", "c": "moy_lease_edge", "out": {"src": null}, "err": "lease", "example": [12345, 1, 4]},
      {"py": "edge_close(h, pin)", "c": "moy_lease_edge_close", "err": "lease", "example": [12345, 1]},
      {"py": "pin_state(pin)", "c": "moy_lease_pin_state", "example": [2]},
      {"py": "device_name(cls)", "c": "moy_lease_device_name", "example": [4]},
      {"py": "sim_pin(pin, state, level)", "c": "moy_lease_sim_pin", "example": [2, 1, 1]},
      {"py": "sim_level(pin, level)", "c": "moy_lease_sim_level", "example": [2, 0]},
      {"py": "sim_get(pin)", "c": "moy_lease_sim_get", "example": [2]},
      {"py": "reset()", "c": "moy_lease_reset", "example": []},
      {"py": "Wifi", "hand": true},
      {"py": "wifi_reset()", "hand": true},
      {"py": "WIFI_TAGS", "hand": true}
    ]
  },
  "moy_evq": {
    "about": "the service queues, native/moy_kernel/moy_evq.h",
    "host": "moy_evq",
    "headers": ["moy_evq.h", "moy_super.h", "moy_vmq.h", "moy_status.h", "moy_notes.h", "moy_items.h", "moy_screen_slot.h"],
    "consts": [
      "MOY_EVQ_OK as OK", "MOY_EVQ_STALE as STALE", "MOY_EVQ_FULL as FULL",
      "MOY_EVQ_NOMEM as NOMEM", "MOY_EVQ_DENIED as DENIED", "MOY_EVQ_DEAF as DEAF",
      "MOY_EVQ_EMPTY as EMPTY", "MOY_EVQ_RANGE as RANGE", "MOY_SUPER_FINE as FINE",
      "MOY_SUPER_WARNED as WARNED", "MOY_SUPER_STRUCK as STRUCK",
      "MOY_SUPER_SUSPENDED as SUSPENDED", "MOY_SUPER_SLICE_US as SLICE_US",
      "MOY_SUPER_ABORT_US as ABORT_US", "MOY_SUPER_STRIKES as STRIKES",
      "MOY_EVQ_DEPTH as DEPTH", "MOY_EVQ_SENDER as SENDER", "MOY_EVQ_BATCH as BATCH",
      "MOY_EVQ_WANT_MAIL as WANT_MAIL", "MOY_EVQ_WANT_POLL as WANT_POLL"
    ],
    "structs": ["moy_status_item_t", "moy_notes_note_t"],
    "rows": [
      {"py": "open(pid, app, receives='', vm=False, alarms=False, notify=False)", "hand": true},
      {"py": "close(pid)", "c": "moy_evq_close", "example": [901]},
      {"py": "has(pid)", "c": "moy_evq_has", "example": [901]},
      {"py": "app(pid)", "c": "moy_evq_app", "example": [901]},
      {"py": "listen(pid, name, on)", "c": "moy_evq_listen", "example": [901, "tick", true]},
      {"py": "hears(pid, name)", "c": "moy_evq_hears", "example": [901, "tick"]},
      {"py": "post(to, frm, name, args)", "c": "moy_evq_post", "span": ["args"], "example": [901, 1, "tick", "{}"]},
      {"py": "send(frm, app, name, args)", "hand": true},
      {"py": "route(name, args)", "c": "moy_evq_route", "span": ["args"], "example": ["tick", "[1]"]},
      {"py": "take(pid)", "hand": true},
      {"py": "queued(pid)", "c": "moy_evq_queued", "example": [901]},
      {"py": "screen_open(pid, w, h, depth)", "c": "moy_screen_slot_open", "example": [901, 0, 0, 1]},
      {"py": "screen_close(pid)", "c": "moy_screen_slot_close", "example": [901]},
      {"py": "screen_told(pid)", "c": "moy_screen_slot_told", "example": [901]},
      {"py": "screen_frame(pid, held, pressed, ms, max_ms, words=None)", "hand": true},
      {"py": "screen_pixels(pid)", "hand": true},
      {"py": "ready()", "c": "moy_evq_ready", "example": []},
      {"py": "step(pid)", "c": "moy_evq_step", "example": [901]},
      {"py": "charge(pid, cost_us, aborted)", "hand": true},
      {"py": "held(pid)", "c": "moy_super_held", "example": [901]},
      {"py": "resume(pid)", "hand": true},
      {"py": "rungs(pid)", "hand": true},
      {"py": "forget(pid)", "c": "moy_super_forget", "example": [901]},
      {"py": "serve()", "c": "moy_vmq_serve", "example": []},
      {"py": "vm(up=None)", "hand": true},
      {"py": "timer(pid, ms, every=0)", "hand": true},
      {"py": "timer_cancel(pid, tid)", "c": "moy_evq_timer_cancel", "trunc": ["id"], "example": [901, 5]},
      {"py": "timer_set(pid, tid, ms)", "c": "moy_evq_timer_set", "trunc": ["id"], "example": [901, 5, 0]},
      {"py": "alarm(pid, ms, wakes=True)", "hand": true},
      {"py": "clock(step_ms)", "c": "moy_evq_clock", "absent": ["mp"]},
      {"py": "woke()", "c": "moy_evq_woke", "example": []},
      {"py": "termed()", "c": "moy_evq_termed", "example": []},
      {"py": "items_hand(pid, h, kind, name, rw)", "c": "moy_items_hand", "span": ["kind", "name"], "example": [901, 3, "file", "a.txt", true]},
      {"py": "items_end(pid, h=0)", "c": "moy_items_end", "example": [901]},
      {"py": "items_reset()", "c": "moy_items_reset", "example": []},
      {"py": "notes_id()", "c": "moy_notes_id", "example": []},
      {"py": "notes_waiting()", "c": "moy_notes_waiting", "example": []},
      {"py": "notes_post(pid, summary, body)", "c": "moy_notes_post", "span": ["summary", "body"], "example": [901, "Hi", ""]},
      {"py": "notes_system(summary, body)", "c": "moy_notes_system", "span": ["summary", "body"], "example": ["Hi", ""]},
      {"py": "notes_take()", "hand": true},
      {"py": "notes_goal(pid, ach_id, goal)", "c": "moy_notes_goal", "span": ["id"], "example": [901, "win", 3]},
      {"py": "notes_award(pid, ach_id)", "c": "moy_notes_award", "span": ["id"], "example": [901, "win"]},
      {"py": "notes_progress(pid, ach_id, value)", "c": "moy_notes_progress", "span": ["id"], "example": [901, "win", 1]},
      {"py": "notes_run()", "hand": true},
      {"py": "notes_end(pid)", "c": "moy_notes_end", "example": [901]},
      {"py": "notes_reset()", "c": "moy_notes_reset", "example": []},
      {"py": "status_add(pid, icon, order, compiled)", "c": "moy_status_add", "span": ["icon"], "example": [901, "wifi", 2, false]},
      {"py": "status_show(pid, h, state)", "c": "moy_status_show", "example": [901, 1, 1]},
      {"py": "status_remove(pid, h)", "c": "moy_status_remove", "example": [901, 1]},
      {"py": "status_sweep(pid)", "c": "moy_status_sweep", "example": [901]},
      {"py": "status_gen()", "hand": true},
      {"py": "status_get(h)", "hand": true},
      {"py": "status_reset()", "c": "moy_status_reset", "example": []},
      {"py": "timers(pid)", "c": "moy_evq_timers", "example": [901]},
      {"py": "timers_run()", "hand": true},
      {"py": "fired()", "c": "moy_evq_fired", "example": []},
      {"py": "wake_id()", "c": "moy_evq_id", "example": []},
      {"py": "next_call()", "hand": true},
      {"py": "answer(ticket, ans)", "hand": true},
      {"py": "drop(pid)", "c": "moy_vmq_drop", "example": [901]},
      {"py": "vm_stop()", "c": "moy_evq_vm_stop", "example": []},
      {"py": "live()", "c": "moy_evq_live", "example": []},
      {"py": "want(bits)", "c": "moy_evq_want", "example": [0]},
      {"py": "wanted(mask)", "c": "moy_evq_wanted", "example": [0]},
      {"py": "wants()", "c": "moy_evq_wants", "example": []},
      {"py": "listening(name)", "c": "moy_evq_listening", "example": ["tick"]},
      {"py": "reset()", "hand": true},
      {"py": "SYSTEM", "hand": true}
    ]
  }
}
