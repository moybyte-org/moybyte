{
  "moy_http": {
    "about": "the http device API's fetches, native/moy_net/moy_fetch.h",
    "host": "moy_http",
    "headers": ["moy_fetch.h", "moy_ota.h"],
    "consts": [
      "MOY_FETCH_QUEUED as QUEUED", "MOY_FETCH_RUNNING as RUNNING", "MOY_FETCH_DONE as DONE",
      "MOY_FETCH_FAILED as FAILED", "MOY_FETCH_STREAM as STREAM",
      "MOY_FETCH_CAP_MAX as CAP_MAX", "MOY_HTTPC_ETLS as ETLS", "MOY_HTTPC_ECERT as ECERT"
    ],
    "rows": [
      {"py": "open(owner, url, cap)", "c": "moy_fetch_open", "out": {"h": null}, "neg_out": true, "example": [3, "ftp://x", 1024]},
      {"py": "state(h)", "c": "moy_fetch_state", "out": {"status": null, "n": null, "err": null}, "neg_out": "tuple", "example": [12345]},
      {"py": "read(h, off, buf)", "c": "moy_fetch_read", "wbuf": ["buf"], "example": [77, 0, {"bytearray": 8}]},
      {"py": "stream(owner, url, window)", "c": "moy_fetch_stream", "out": {"h": null}, "neg_out": true, "example": [3, "ftp://x", 1024]},
      {"py": "take(h, buf)", "c": "moy_fetch_take", "wbuf": ["buf"], "example": [77, {"bytearray": 8}]},
      {"py": "tls()", "c": "moy_fetch_tls", "example": []},
      {"py": "close(h)", "c": "moy_fetch_close", "example": [77]},
      {"py": "sweep(owner)", "c": "moy_fetch_sweep", "example": [3]},
      {"py": "count(owner)", "c": "moy_fetch_count", "example": [3]},
      {"py": "source()", "c": "moy_fetch_source", "example": []},
      {"py": "run()", "c": "moy_fetch_run", "example": []},
      {"py": "present()", "c": "moy_fetch_present", "ret": "bool", "example": []},
      {"py": "reset()", "c": "moy_fetch_reset", "example": []}
    ]
  },
  "moy_net": {
    "about": "the network: sockets, TLS, the web host, Wi-Fi, OTA, native/moy_net",
    "host": "net_binding",
    "registered": false,
    "headers": ["moy_seal.h", "moy_net.h", "moy_ota.h", "moy_page.h"],
    "consts": [
      "MOY_SEAL_PW_ITER as PW_ITER"
    ],
    "structs": [
      {"c": "moy_http_req_t", "addr": ["method", "target"]},
      {"c": "moy_sync_batch_t", "addr": ["ops", "ops_end"]},
      {"c": "moy_sync_store_t", "addr": ["shelf"]}, "moy_sync_result_t", "moy_web_cfg_t",
      "moy_web_state_t", "moy_ota_state_t", "moy_wc_state_t",
      {"c": "moy_sync_env_t", "addr": ["v", "v_end", "root", "root_end", "ops", "ops_end"]}
    ],
    "when": {"SERVE": "MOY_NET_SERVE", "WIFI": "defined(MOY_NET_WIFI) && MOY_NET_WIFI"},
    "rows": [
      {"py": "encode_batch(v, root_id, ops)", "hand": true},
      {"py": "decode_batch(body)", "hand": true},
      {"py": "sync_batch(body)", "hand": true},
      {"py": "sync_apply(carts, files, kinds, root_id, ops, journal, apps=None)", "hand": true},
      {"py": "sync_path(rel, history)", "c": "moy_sync_path", "span": ["p"], "flag": ["history"], "example": ["carts/a.moy/main.py", 0]},
      {"py": "sync_song(name)", "c": "moy_sync_song", "span": ["name"], "ret": "bool", "example": ["a.mp3"]},
      {"py": "pw_hash(password, salt)", "hand": true},
      {"py": "parse_request(raw)", "hand": true},
      {"py": "query_param(target, name)", "hand": true},
      {"py": "http_response(status, body, content_type='application/json')", "hand": true},
      {"py": "wifi_password(password, stored)", "hand": true},
      {"py": "wifi_remember(ok, password, stored)", "hand": true},
      {"py": "web_start(port, carts, files, kinds, system, defer, apps=None)", "hand": true},
      {"py": "web_stop(why=None)", "c": "moy_web_stop", "null": ["why"], "when": "SERVE"},
      {"py": "web_auth(system)", "hand": true},
      {"py": "web_keys()", "hand": true},
      {"py": "web_key_drop(kid)", "c": "moy_web_key_drop", "when": "SERVE"},
      {"py": "web_signout()", "c": "moy_web_signout", "when": "SERVE"},
      {"py": "web_poll()", "c": "moy_web_poll", "ret": "bool", "guard": "WEB_GUARD", "when": "SERVE"},
      {"py": "web_state()", "c": "moy_web_state", "out": {"out": ["serving?", "closing?", "parked?", "port", "requests", "err"]}, "when": "SERVE"},
      {"py": "web_events()", "c": "moy_web_events", "when": "SERVE"},
      {"py": "web_shelf()", "hand": true},
      {"py": "web_take()", "hand": true},
      {"py": "web_answer(resp)", "c": "moy_web_answer", "span": ["resp"], "when": "SERVE"},
      {"py": "web_pack(root, kinds, binary=False)", "hand": true},
      {"py": "web_stamp()", "c": "moy_web_stamp_text", "when": "SERVE"},
      {"py": "page_at(path)", "c": "moy_page_at", "when": "SERVE"},
      {"py": "page_state()", "c": "moy_page_state", "when": "SERVE"},
      {"py": "page_why()", "c": "moy_page_why", "when": "SERVE"},
      {"py": "page_say(why, offer)", "c": "moy_page_say", "when": "SERVE"},
      {"py": "page_asked()", "c": "moy_page_asked", "when": "SERVE"},
      {"py": "wc_on(port, carts, files, kinds, system, defer, ip, apps=None)", "hand": true},
      {"py": "wc_off(why=None)", "c": "moy_wc_off", "null": ["why"], "when": "SERVE"},
      {"py": "wc_poll()", "c": "moy_wc_poll", "ret": "bool", "when": "SERVE"},
      {"py": "wc_state()", "hand": true},
      {"py": "wc_phase(port)", "hand": true},
      {"py": "dns_start(ip, port)", "hand": true},
      {"py": "dns_port()", "c": "moy_dns_port", "when": "SERVE"},
      {"py": "dns_reply(query, ip)", "hand": true},
      {"py": "dns_poll()", "c": "moy_dns_poll", "when": "SERVE"},
      {"py": "dns_stop()", "c": "moy_dns_stop", "when": "SERVE"},
      {"py": "wc_park(on)", "c": "moy_wc_park", "when": "SERVE"},
      {"py": "wc_url(paired)", "hand": true},
      {"py": "ota_keys()", "hand": true},
      {"py": "ota_verify(payload, sig, keys=None)", "hand": true},
      {"py": "ota_judge(text, board, require_sig, keys=None)", "hand": true},
      {"py": "ota_canonical(manifest_text)", "hand": true},
      {"py": "ota_canonical_c6(manifest_text)", "hand": true},
      {"py": "ota_check(url, board, require_sig)", "hand": true},
      {"py": "ota_judge_c6(text, require_sig, keys=None)", "hand": true},
      {"py": "ota_dl_begin(url, size, sha256, sink)", "hand": true},
      {"py": "ota_dl_step(max_bytes)", "c": "moy_ota_dl_step", "when": "SERVE"},
      {"py": "ota_dl_finish()", "c": "moy_ota_dl_finish", "ret": "ok", "when": "SERVE"},
      {"py": "ota_cancel()", "c": "moy_ota_cancel", "when": "SERVE"},
      {"py": "ota_slot_begin(size)", "hand": true},
      {"py": "ota_slot_write(data)", "c": "moy_ota_slot_write", "span": ["p"], "ret": "ok", "when": "SERVE"},
      {"py": "ota_slot_close()", "c": "moy_ota_slot_close", "ret": "ok", "when": "SERVE"},
      {"py": "ota_activate()", "hand": true},
      {"py": "ota_c6_commit()", "c": "moy_ota_c6_commit", "ret": "ok", "when": "SERVE"},
      {"py": "ota_c6_version()", "hand": true},
      {"py": "ota_state()", "c": "moy_ota_state", "out": {"out": ["phase", "sink", "dl_done", "dl_total", "done", "total", "err"]}, "when": "SERVE"},
      {"py": "http_open(url, agent)", "hand": true},
      {"py": "http_readinto(h, buf)", "hand": true},
      {"py": "http_close(h)", "c": "moy_httpc_close", "when": "SERVE"},
      {"py": "clock_state()", "hand": true},
      {"py": "clock_server(name)", "hand": true},
      {"py": "wifi_on()", "hand": true, "absent": ["host"]},
      {"py": "wifi_off()", "c": "moy_wifi_off", "when": "WIFI", "absent": ["host"]},
      {"py": "wifi_connect(ssid, password)", "hand": true, "absent": ["host"]},
      {"py": "wifi_disconnect()", "c": "moy_wifi_disconnect", "when": "WIFI", "absent": ["host"]},
      {"py": "wifi_forget(ssid)", "c": "moy_wifi_forget_kept", "when": "WIFI", "absent": ["host"]},
      {"py": "wifi_ap(ssid)", "hand": true, "absent": ["host"]},
      {"py": "wifi_ap_mac()", "hand": true, "absent": ["host"]},
      {"py": "wifi_mdns(host)", "hand": true, "absent": ["host"]},
      {"py": "wifi_status()", "hand": true, "absent": ["host"]},
      {"py": "wifi_scan(a0=None)", "hand": true, "absent": ["host"]},
      {"py": "wifi_mac()", "hand": true, "absent": ["host"]},
      {"py": "wifi_ps(a0=None)", "hand": true, "absent": ["host"]},
      {"py": "Link", "hand": true, "absent": ["host"]},
      {"py": "RATE_54M", "hand": true, "absent": ["host"]},
      {"py": "RATE_12M", "hand": true, "absent": ["host"]},
      {"py": "build(verbose=False)", "hand": true, "absent": ["mp"]},
      {"py": "net_vm_stop()", "hand": true, "absent": ["mp"]},
      {"py": "ota_admit_module(data, scheme, chip, consented, keys=None)", "hand": true, "absent": ["mp"]},
      {"py": "pw_check(password, record)", "hand": true, "absent": ["mp"]},
      {"py": "web_handle(method, target, body)", "hand": true, "absent": ["mp"]},
      {"py": "web_handle_answer(resp)", "hand": true, "absent": ["mp"]},
      {"py": "web_token()", "hand": true, "absent": ["mp"]}
    ]
  },
  "moy_lora": {
    "about": "the LoRa radio, native/moy_net/moy_lora.h",
    "host": "moy_lora",
    "lazy": true,
    "structs": ["moy_lora_cfg_t"]
  }
}
