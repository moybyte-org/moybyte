.venv/
.idea/
# local Claude Code settings + agent worktrees
.claude/
__pycache__/
.pytest_cache/
*.egg-info/
examples/*/generated/
# Local GitHub issue mirror, generated by `make sync-issues` (GitHub is the source of truth)
docs/issues/
*.kc8
.pio/
firmware/**/.pio/
firmware/lilygo_t_deck_plus_micropython/.build
firmware/esp32_p4_wifi6_touch_lcd_7b/.build
firmware/lilygo_t_deck_plus_micropython/dist/
/dist/
# The two boards' staged modules/ trees are ignored by PATTERN, in each board's
# own .gitignore -- not by a list here. This used to be a hand-maintained
# enumeration of every staged file, i.e. a third copy of the staging allowlist
# beside build.sh's and each board's own; it had gone stale in both directions
# (it still named canvas.py / web_view.py / web_view_page.py, gone; it would
# have missed every module added after it). #161 Phase 3 made staging a
# denylist declared in firmware/<board>/board.toml, so a new shared module
# reaches a board without anyone editing anything -- and an ignore list that has
# to be edited for each one would have put the paperwork straight back.
firmware/lilygo_t_deck_plus_reference/
firmware/reference_tulipcc/
firmware/lilygo_t_deck_plus/include/moybyte_project_bundle.h
# ports/celeste.moy is generated by tools/p8_lua_port.py from the CC BY-NC-SA
# BBS cart (see ports/README.md) -- the tool + README stay tracked, the
# license-encumbered cart content does not.
ports/celeste.moy/

# The web runner (#151) static bundle output (build.sh assembles it; .build is
# covered by the build-trees rule above).
firmware/web_runner/dist/
# ...and the C file that BAKES that bundle into the firmware image
# (tools/gen_web_blob.py, run by both boards' build.sh). Generated, because it
# carries absolute .incbin paths and a digest of build output -- and because a
# build that writes into a TRACKED file would leave the tree dirty, which
# `make release` refuses.
firmware/lilygo_t_deck_plus_micropython/native/moy_web/moy_web_blob.gen.c
# The toolchain (emsdk + a micropython checkout, ~2GB). No trailing slash:
# a shared toolchain is often a SYMLINK to another checkout's copy, and a
# `.build/` pattern matches directories only -- which is how one got
# committed, absolute local path and all.
firmware/web_runner/.build
# A sibling moy-spec checkout, when one is made inside this tree (the retired
# web-player CI job did; `make vendor-libmoy` can).
.moy-spec/

# Generated website (site/build.py assembles it from the canonical sources)
_site/

# Screenshot harness output (pageshot.mjs / browsershot.mjs)
firmware/web_runner/shots/
firmware/web_runner/shots-browser/

# Host audio binding cache (runtime/audio_binding.py, #97 stage 0)
/.build/
