# Moybyte M5Stack Core2 board fragment (mainline build).
#
# The first classic-ESP32 board: an ESP32-D0WDQ6-V3 (revision 3.1, read off
# this glass 2026-11-01), 16MB QIO flash, 8MB quad PSRAM on the WROVER pins
# (16/17), and a CH9102 USB-UART bridge instead of a USB-Serial/JTAG. Every
# lever below is a CHIP fact or a bring-up choice; the S3 boards' MSPI, cache
# geometry and USJ console sections do not exist on this chip and are not here.

# 16MB flash, QIO @ 80MHz.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Revision 3 silicon: the PSRAM cache bug the port's sdkconfig.spiram works
# around (CONFIG_SPIRAM_CACHE_WORKAROUND, a memw after every PSRAM store) is
# fixed in it, so the image requires rev 3 and drops the workaround. An image
# built this way refuses to boot on an older chip instead of corrupting.
CONFIG_ESP32_REV_MIN_3=y
CONFIG_SPIRAM_CACHE_WORKAROUND=

# PSRAM at 80MHz (the port's default is 40). The WROVER-style wiring (CS 16,
# CLK 17) is the one IDF's 80MHz timing supports on this chip.
CONFIG_SPIRAM_SPEED_80M=y

# The dual-OTA partition table (#53) -- the S3 boards' layout, two 7 MiB app
# slots and the vfs. CONFIG_PARTITION_TABLE_CUSTOM_FILENAME resolves relative
# to ports/esp32, so build.sh stages the CSV there.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-moybyte-core2.csv"

CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The console is UART0 over the CH9102 at the port's default 115200: what the
# ROM, the bootloader and the REPL all speak, so a monitor never changes baud.

# --- BLE right-sized for ONE keyboard (the Guition S3's block, same reason) --
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=2
CONFIG_BT_NIMBLE_MAX_CCCDS=4
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=8
CONFIG_BT_NIMBLE_HCI_EVT_HI_BUF_COUNT=10
CONFIG_BT_NIMBLE_HCI_EVT_LO_BUF_COUNT=4
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_MSYS1_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_TASK_STACK_SIZE=4096

# lwIP and WiFi buffers in PSRAM where the driver allows it: internal SRAM is
# the scarce resource on this chip (about 300 KB of heap at all, against the
# S3's 400).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Power management: no user (the Guition S3's prose).
CONFIG_PM_ENABLE=

# No PSRAM memtest at every boot (both S3s and both P4s run without it).
CONFIG_SPIRAM_MEMTEST=

# The task watchdog (#160): a frame that never ends is a crash record.
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15

# TLS in PSRAM (the Guition S3's #224 block).
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
