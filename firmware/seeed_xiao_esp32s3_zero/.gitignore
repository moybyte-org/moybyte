.build/
# Shared native modules staged by build.sh per board.toml (canonical: native/).
native/.staged/
# modules/ mixes board-authored files (tracked, whitelisted below) with copies
# staged at build time -- board.toml declares which cross. The whitelist is
# ALSO what the stager's prune reads: a tracked file is board-authored and
# never deleted; any untracked .py board.toml does not stage is pruned.
modules/*
!modules/boot.py
!modules/main.py
!modules/zero_host.py
!modules/zero_setup.py
!modules/zero_gpio.py
