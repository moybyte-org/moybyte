# Moybyte Guition JC3248W535 board fragment (mainline build).
#
# Everything here is a BOARD FACT or a deliberately conservative bring-up
# choice with the A/B it defers named beside it. The reference points are the
# T-Deck's sdkconfig.board (same chip, and the source of every lever verdict
# below) and the owner's working ESPHome config for this exact board
# (~/Documents/Work/esphome/JC3248W535.yaml -- pins verified, tuning NOT
# transferable, per docs/board_ports_2026-08.md).

# 16MB flash, DIO @ 80MHz -- the ESPHome build's proven mode on this board
# (board_build.flash_mode: dio, f_flash 80MHz). The generic S3 board assumes
# 4MB QIO.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# The dual-OTA partition table (#53) -- the T-Deck's S3 layout, adopted fresh
# (no field devices to migrate). CONFIG_PARTITION_TABLE_CUSTOM_FILENAME
# resolves relative to ports/esp32, so build.sh stages the CSV there.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-moybyte-guition-s3.csv"

# Rollback (#53): restated here because build.sh's stale-sdkconfig guard greps
# the GENERATED config for it.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Cache geometry: the T-Deck's #63 A/B verdict (32KB icache / 64KB dcache)
# adopted as the starting point -- same chip, same VM-reads-frozen-bytecode +
# gc-heap-in-PSRAM + panel-DMA-through-one-dcache workload.
#
# The LINE is 32B, and this is the one place this file knowingly DIVERGES from
# the ESPHome config that otherwise vouches for the board: ESPHome runs
# DATA_CACHE_LINE_64B here, but the T-Deck's on-glass verdict was that 64B
# lines break the CPU<->GDMA handoff in OUR SRAM-bounce flush path (horizontal
# garbage bands), and this board runs that flush path, not ESPHome's. Per-board
# verdicts don't transfer in either direction, so 64B is a legitimate A/B to
# run on this glass later -- from a working 32B baseline, not blind.
CONFIG_ESP32S3_INSTRUCTION_CACHE_16KB=
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_32KB=
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_32B=y

# PSRAM + flash at 120MHz -- the T-Deck's experimental profile, adopted here
# 2026-08-19 as the deferred bring-up A/B (owner call: "try 120mhz"), from a
# proven 80MHz baseline whose image is the rollback. The T-Deck's rules carry
# over verbatim (read its sdkconfig.board for the full prose): all five flags
# together or none -- PSRAM-120 has no timing table against flash-80 at a
# 240MHz core, so flash moves too; 120M is Kconfig-gated behind
# IDF_EXPERIMENTAL_FEATURES; the S3's 120M PSRAM timing drifts with
# temperature, so the 5s retune rides along; and the retune REQUIRES the #169
# vendor-gate patch (build.sh applies it) or an unverified flash vendor id
# ABORTS THE BOOT -- a board that flashes cleanly and never says a word.
# Do NOT read the generated sdkconfig's FLASHFREQ string to check this landed
# ("80m" is correct and stays -- the image header cannot encode 120M; the MSPI
# tuning code applies it at runtime). One divergence from the T-Deck: its
# flash is octal, this board's is DIO -- whether IDF 5.5.1 carries a DIO@120M
# timing config is part of what this A/B answers -- it does: the build takes
# it and the board runs it. A/B'D ON THIS GLASS 2026-08-19, identical image,
# only the MSPI profile differing, and 120M won EVERYWHERE: Star Catcher
# 24->30fps, Sakura Lua 21->27fps (both UNCAPPED natural rates -- the #63
# governor ships off; the same carts run 60/50 on the T-Deck, and that gap
# is this board's open per-frame ledger item, not a cap), pump CPU
# 9.6->7.3ms, SPI
# starvation 3.3->0.7ms, scripted-swipe transition spikes 84->~70ms, steady
# drag frames ~30->25ms. (The control run also priced the landscape rotate
# honestly: ~4ms/frame at 80M, folded to ~2ms net by this clock.) Same
# temperature-drift risk profile the T-Deck accepted; if the panel ever shows
# garbage bands or the board wedges under sustained load, THIS block is the
# first revert, exactly as on the T-Deck.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
CONFIG_SPIRAM_SPEED_80M=
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_SPIRAM_TIMING_TUNING_POINT_VIA_TEMPERATURE_SENSOR=y
CONFIG_SPIRAM_TIMING_MEASURE_TEMPERATURE_INTERVAL_SECOND=5

# USB-Serial-JTAG as the PRIMARY console (#201, the T-Deck's three-part RX
# fix; parts 1 and 3 are MICROPY_HW_ENABLE_USBDEV/UART_REPL in
# mpconfigboard.h). A secondary console is output-only by design; primary +
# USBDEV off is what gives this board a live dev channel under the desktop.
CONFIG_ESP_CONSOLE_UART_DEFAULT=
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
