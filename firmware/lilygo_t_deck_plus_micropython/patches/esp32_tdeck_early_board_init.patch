--- a/ports/esp32/main.c
+++ b/ports/esp32/main.c
@@ -42,6 +42,7 @@
 #include "esp_log.h"
 #include "esp_memory_utils.h"
 #include "esp_psram.h"
+#include "driver/gpio.h"
 
 #include "py/cstack.h"
 #include "py/nlr.h"
@@ -76,6 +77,43 @@
 // MicroPython runs as a task under FreeRTOS
 #define MP_TASK_PRIORITY        (ESP_TASK_PRIO_MIN + 1)
 
+#define KIDCODE_TDECK_POWERON   GPIO_NUM_10
+#define KIDCODE_TDECK_SDCARD_CS GPIO_NUM_39
+#define KIDCODE_TDECK_RADIO_CS  GPIO_NUM_9
+#define KIDCODE_TDECK_TFT_CS    GPIO_NUM_12
+#define KIDCODE_TDECK_SPI_MISO  GPIO_NUM_38
+
+static void kidcode_tdeck_early_board_init(void) {
+    const uint64_t output_mask =
+        (1ULL << KIDCODE_TDECK_POWERON)
+        | (1ULL << KIDCODE_TDECK_SDCARD_CS)
+        | (1ULL << KIDCODE_TDECK_RADIO_CS)
+        | (1ULL << KIDCODE_TDECK_TFT_CS);
+
+    gpio_config_t output_config = {
+        .pin_bit_mask = output_mask,
+        .mode = GPIO_MODE_OUTPUT,
+        .pull_up_en = GPIO_PULLUP_DISABLE,
+        .pull_down_en = GPIO_PULLDOWN_DISABLE,
+        .intr_type = GPIO_INTR_DISABLE,
+    };
+    gpio_config(&output_config);
+
+    gpio_set_level(KIDCODE_TDECK_POWERON, 1);
+    gpio_set_level(KIDCODE_TDECK_SDCARD_CS, 1);
+    gpio_set_level(KIDCODE_TDECK_RADIO_CS, 1);
+    gpio_set_level(KIDCODE_TDECK_TFT_CS, 1);
+
+    gpio_config_t miso_config = {
+        .pin_bit_mask = (1ULL << KIDCODE_TDECK_SPI_MISO),
+        .mode = GPIO_MODE_INPUT,
+        .pull_up_en = GPIO_PULLUP_ENABLE,
+        .pull_down_en = GPIO_PULLDOWN_DISABLE,
+        .intr_type = GPIO_INTR_DISABLE,
+    };
+    gpio_config(&miso_config);
+}
+
 typedef struct _native_code_node_t {
     struct _native_code_node_t *next;
     uint32_t data[];
@@ -134,6 +172,8 @@
     }
 
 soft_reset:
+    kidcode_tdeck_early_board_init();
+
     // initialise the stack pointer for the main thread
     mp_cstack_init_with_top((void *)sp, MICROPY_TASK_STACK_SIZE);
     gc_init(mp_task_heap, mp_task_heap + MICROPY_GC_INITIAL_HEAP_SIZE);
@@ -222,6 +262,7 @@
     #endif
     // TODO: machine_rmt_deinit_all();
     machine_pins_deinit();
+    kidcode_tdeck_early_board_init();
     #if MICROPY_PY_MACHINE_I2C_TARGET
     mp_machine_i2c_target_deinit_all();
     #endif
@@ -273,6 +314,8 @@
 }
 
 void MICROPY_ESP_IDF_ENTRY(void) {
+    kidcode_tdeck_early_board_init();
+
     // Hook for a board to run code at start up.
     // This defaults to initialising NVS and detecting the flash size.
     MICROPY_BOARD_STARTUP();
