# Waveshare P4-7B board fragment (#58).

# PSRAM at 200MHz: the 1024x600@60Hz DPI scan-out streams ~104MB/s from the
# PSRAM framebuffer; at the default speed the DSI fetcher underruns
# ("can't fetch data from external memory fast enough" -- confirmed on
# hardware). Matches Waveshare's demo sdkconfig.
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# The board has 32MB flash (the generic P4 board assumes 16MB).
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# Custom partition table (#58 console staging): the default 4MiBplus table caps
# the app at ~1.94MB and the frozen console overflows it. OTA-shaped 2x4MB app
# slots + auto-vfs tail; the CSV lives in boards/MOYBYTE_P4/ and build.sh copies
# it into ports/esp32/ (the filename resolves project-relative).
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-moybyte-p4.csv"
