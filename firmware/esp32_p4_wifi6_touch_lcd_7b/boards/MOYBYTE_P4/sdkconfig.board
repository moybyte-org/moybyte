# Waveshare P4-7B board fragment (#58).

# PSRAM at 200MHz: the 1024x600@60Hz DPI scan-out streams ~104MB/s from the
# PSRAM framebuffer; at the default speed the DSI fetcher underruns
# ("can't fetch data from external memory fast enough" -- confirmed on
# hardware). Matches Waveshare's demo sdkconfig.
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# The DSI driver restarts its full-frame DW-GDMA transfer from the completion
# ISR every refresh. Keep that path in internal RAM so scan-out remains viable
# during cache-disabled operations and when it runs at the #106 level-3 priority.
CONFIG_LCD_DSI_ISR_IRAM_SAFE=y

# L2 cache 128KB (IDF default) -> 256KB (#159, A/B'd on glass 2026-07-27): the
# desktop working set thrashes a 128KB L2 -- Brick Siege busy 15.5 -> 8.0ms,
# window drags -5ms/frame, Lua table bench -13%. Costs exactly 128KB of
# internal heap. 512KB does NOT boot: the carve starves MicroPython's
# internal/DMA pool reservation (main_task error 0x101 abort loop), so 256KB
# is the max viable on this port.
CONFIG_CACHE_L2_CACHE_256KB=y

# The board has 32MB flash (the generic P4 board assumes 16MB).
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# Custom partition table (#58 console staging): the default 4MiBplus table caps
# the app at ~1.94MB and the frozen console overflows it. OTA-shaped 2x4MB app
# slots + auto-vfs tail; the CSV lives in boards/MOYBYTE_P4/ and build.sh copies
# it into ports/esp32/ (the filename resolves project-relative).
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-moybyte-p4.csv"

# BLE notifications arrive from the C6 over ESP-Hosted while MicroPython's
# synchronous Bluetooth IRQ may be waiting for the VM/GIL during a long display
# draw.  The upstream 24-buffer pool exhausts under keyboard autorepeat and the
# hosted VHCI driver then drops reports ("alloc_acl_from_ll failed").  Keep enough
# host-bound ACL buffers to absorb those render bursts.
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=64

# MicroPython's ESP32 binding executes synchronous BLE callbacks as Python on
# the NimBLE host task.  The upstream 6144-byte stack is marginal for the P4's
# HID discovery/subscription state machine (hardware panics symbolized inside
# mp_execute_bytecode/mp_obj_print_helper during connect).  Keep ample headroom.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=12288

# OTA rollback (#53 on the P4). The partition table has been OTA-shaped since
# bring-up, but nothing enabled the bootloader's safety net -- so an image that
# failed to come up would have stayed selected, and a bad update would need a
# cable. With this, an app that does not call
# esp32.Partition.mark_app_valid_cancel_rollback() on its first boot is REVERTED
# to the previous slot automatically. moy_runtime.run_desktop makes that call
# once the desktop is up, which is what makes a healthy boot mean "healthy".
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- WiFi: the S3 boards' set, spelled in THIS board's knob namespace -------
# The two S3 boards took Espressif's "Iperf rank" set on 2026-08-21 (0890249)
# and this board was recorded there as untouched BY CONSTRUCTION: its WiFi is
# ESP-Hosted on a C6 over SDIO, so CONFIG_ESP_WIFI_* on the host configures a
# driver that is not here, and its lwIP window was already 65534. The first
# half is true and the second half is the trap. There is no WiFi DRIVER on the
# P4 -- but there is one on the C6, and the host fragment is what configures
# it, under a different name.
#
# esp_wifi_remote's idf_v5.5/Kconfig.wifi.in redefines every CONFIG_ESP_WIFI_*
# as a PROMPTLESS symbol whose sole default is the matching CONFIG_WIFI_RMT_*.
# Those RMT values are marshalled to the C6 inside wifi_init_config_t by the
# ESP-Hosted RPC, and the slave feeds them straight to its own esp_wifi_init
# (managed_components/espressif__esp_hosted/slave/main/slave_control.c). So the
# radio's buffers ARE decided here; they are just not spelled ESP_WIFI_*.
#
# Which means MicroPython's own sdkconfig.p4_wifi_common has been asking with
# the wrong name since bring-up. It sets ESP_WIFI_ STATIC_RX_BUFFER_NUM=16 /
# DYNAMIC_RX=64 / DYNAMIC_TX=64 / RX_BA_WIN=32 / TX_BA_WIN=32, and the
# generated sdkconfig carried IDF's defaults for every one of them --
# 10/32/32/6/6 -- on this board AND on a stock ESP32_GENERIC_P4-C6_WIFI build.
# Nothing reported it, because moybyte_sdkconfig_guard only checks the options
# a BOARD fragment names, and these were named by an upstream one.
#
# That left the console in exactly the half-set state the T-Deck's block warns
# is worse than none of it: TCP_WND 65534 (lwIP runs on the host, so upstream's
# window DID take) against an 802.11n reorder window of 6. ~22 segments in
# flight against a window that holds 6 is drop-and-retransmit, and it is the
# state the S3 measured 20x SLOWER than stock. This board's one recorded WiFi
# number is consistent with that and was never explained: the 2026-08-02 OTA
# download ran at ~55 KB/s here against ~137 KB/s on the T-Deck, on a board
# with a WiFi 6 radio and 2.5x the TCP window.
#
# The values are upstream's own intent, restated in the name Kconfig honours.
# THE SET IS ATOMIC -- read the T-Deck's block before changing one line of it.
#
# The RAM this spends is the C6's, not the console's: the static RX buffers are
# allocated by the SLAVE's esp_wifi_init, so unlike the S3 the internal-SRAM
# argument does not apply here and none of it comes out of a running cart's
# ~31KB. 16-and-not-24 is kept anyway because 16 is the number that was
# measured; 24 is an untested lever on the C6, not a free upgrade.
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_RX_BA_WIN=32
CONFIG_WIFI_RMT_TX_BA_WIN=32

# NOT set here, and each is a decision rather than an omission:
#
#   CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP -- load-bearing on the S3, where it is
#   what makes the set RAM-POSITIVE by moving the lwIP buffers out of a 227KB
#   internal region. This board has ~512KB internal after the L2 carve and no
#   WiFi driver competing for it, so the pressure it relieves does not exist;
#   all it would buy is slower buffers. Revisit only with a measured shortage.
#
#   CONFIG_WIFI_RMT_*_IRAM_OPT -- the S3 declines the three IRAM options because
#   there IRAM aliases DRAM and they would cost ~32KB of the SRAM the set is
#   careful not to spend. Here they are already ON (upstream default) and the
#   IRAM is the C6's, so the S3's reason to decline does not transfer.
#
#   The BLE right-sizing block -- the other half of 0890249, and it does not
#   belong here. Its two biggest levers are CONFIG_BT_CTRL_*, and this board has
#   no BLE controller to size: CONFIG_BT_CONTROLLER_DISABLED=y, the controller
#   is the C6's. What is left is host NimBLE, whose numbers here were raised
#   DELIBERATELY and on hardware evidence (the two blocks above), and which sits
#   in ~512KB rather than the Guition's four free bytes. MAX_CONNECTIONS stays
#   at upstream's 4 on purpose: one BLE keyboard is what is paired today, and a
#   second one is the only local-2P path this board can have (#65 Phase 1).
