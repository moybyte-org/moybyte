@@ -15,6 +15,29 @@
 
 static const char *TAG = "ppa_srm";
 
+// Moybyte P4: the SRM engine's macro-block reorder can deadlock against the
+// 2D-DMA RX FIFO when the last transfer unit of an operation holds fewer bits
+// than the FIFO (12 x 128): the TX channel delivers every input byte, the RX
+// FIFO fills and never drains, and no EOF ever comes (ESP-IDF DIG-734). The
+// test and its constants are ESP-IDF's. Upstream measures the unit on the
+// INPUT block only; a 90/270 rotation transposes the output, so its units are
+// measured on the turned block as well -- the Guition P4's wedged rotate
+// (1280x258 turned 270, a 2-pixel last unit across the output) passes the
+// upstream test and fails the turned one.
+static bool srm_mb_order_stalls(uint32_t w, uint32_t sw_int, uint32_t sw_frag,
+                                uint32_t h, uint32_t sh_int, uint32_t sh_frag,
+                                uint32_t h_mb, uint32_t depth, uint32_t w_divisor)
+{
+    uint32_t w_out = w * sw_int + w * sw_frag / PPA_LL_SRM_SCALING_FRAG_MAX;
+    uint32_t w_left = w_out % w_divisor;
+    w_left = (w_left == 0) ? w_divisor : w_left;
+    uint32_t h_in_left = h % h_mb;
+    h_in_left = (h_in_left == 0) ? h_mb : h_in_left;
+    uint32_t h_left = h_in_left * sh_int + h_in_left * sh_frag / PPA_LL_SRM_SCALING_FRAG_MAX;
+    const uint32_t dma2d_fifo_depth_bits = 12 * 128;
+    return ((w_out > w_divisor) || (h > h_mb)) && ((w_left * h_left * depth) < dma2d_fifo_depth_bits);
+}
+
 bool ppa_srm_transaction_on_picked(uint32_t num_chans, const dma2d_trans_channel_info_t *dma2d_chans, void *user_config)
 {
     assert(num_chans == 2 && dma2d_chans && user_config);
@@ -158,25 +181,20 @@ bool ppa_srm_transaction_on_picked(uint32_t num_chans, const dma2d_trans_channel
     ppa_ll_srm_enable_mirror_y(platform->hal.dev, srm_trans_desc->mirror_y);
 
     // Hardware bug workaround (DIG-734)
-    uint32_t w_out = srm_trans_desc->in.block_w * srm_trans_desc->scale_x_int + srm_trans_desc->in.block_w * srm_trans_desc->scale_x_frag / PPA_LL_SRM_SCALING_FRAG_MAX;
     uint32_t w_divisor = (ppa_out_color_mode == PPA_SRM_COLOR_MODE_ARGB8888 || ppa_out_color_mode == PPA_SRM_COLOR_MODE_RGB888) ? 32 : 64;
-    uint32_t w_left = w_out % w_divisor;
-    w_left = (w_left == 0) ? w_divisor : w_left;
     uint32_t h_mb = (ppa_ll_srm_get_mb_size(platform->hal.dev) == PPA_LL_SRM_MB_SIZE_16_16) ? 16 : 32;
-    uint32_t h_in_left = srm_trans_desc->in.block_h % h_mb;
