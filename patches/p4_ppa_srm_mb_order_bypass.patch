-            ((w_left * h_left * out_pixel_depth) < dma2d_fifo_depth_bits)
-       ) {
-        bypass_mb_order = true;
-    }
+    bool turned = srm_trans_desc->rotation_angle == PPA_SRM_ROTATION_ANGLE_90
+                  || srm_trans_desc->rotation_angle == PPA_SRM_ROTATION_ANGLE_270;
+    bool bypass_mb_order = srm_mb_order_stalls(srm_trans_desc->in.block_w, srm_trans_desc->scale_x_int, srm_trans_desc->scale_x_frag,
+                                               srm_trans_desc->in.block_h, srm_trans_desc->scale_y_int, srm_trans_desc->scale_y_frag,
