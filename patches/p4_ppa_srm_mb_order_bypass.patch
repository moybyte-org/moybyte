 #include "esp_cache.h"
 #include "esp_memory_utils.h"
 #include "soc/dma2d_channel.h"
+#include "hal/color_hal.h"
 
 static const char *TAG = "ppa_srm";
 
+// Moybyte P4: the SRM engine's macro-block reorder can deadlock against the
+// 2D-DMA RX FIFO when the last transfer unit of an operation holds fewer bits
+// than the FIFO (12 x 128): the TX channel delivers every input byte, the RX
+// FIFO fills and never drains, and no EOF ever comes (ESP-IDF DIG-734). The
+// test and its constants are ESP-IDF's (release/v5.5 1b13ef0498), whose 16x16
+// macro block is this chip revision's (< v3.0). Upstream measures the unit on
+// the INPUT block only; a 90/270 rotation transposes the output, so its units
+// are measured on the turned block as well -- the Guition P4's wedged rotate
+// (1280x258 turned 270, a 2-pixel last unit across the output) passes the
+// upstream test and fails the turned one.
+static bool srm_mb_order_stalls(uint32_t w, uint32_t sw_int, uint32_t sw_frag,
+                                uint32_t h, uint32_t sh_int, uint32_t sh_frag,
+                                uint32_t depth, uint32_t w_divisor)
+{
+    const uint32_t h_mb = 16;
+    uint32_t w_out = w * sw_int + w * sw_frag / PPA_LL_SRM_SCALING_FRAG_MAX;
+    uint32_t w_left = w_out % w_divisor;
+    w_left = (w_left == 0) ? w_divisor : w_left;
+    uint32_t h_in_left = h % h_mb;
+    h_in_left = (h_in_left == 0) ? h_mb : h_in_left;
+    uint32_t h_left = h_in_left * sh_int + h_in_left * sh_frag / PPA_LL_SRM_SCALING_FRAG_MAX;
+    const uint32_t dma2d_fifo_depth_bits = 12 * 128;
+    return ((w_out > w_divisor) || (h > h_mb)) && ((w_left * h_left * depth) < dma2d_fifo_depth_bits);
+}
