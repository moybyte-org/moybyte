diff --git components/esp_lcd/dsi/esp_lcd_panel_dpi.c components/esp_lcd/dsi/esp_lcd_panel_dpi.c
index 6e9b78bd..81975099 100644
--- a/components/esp_lcd/dsi/esp_lcd_panel_dpi.c
+++ b/components/esp_lcd/dsi/esp_lcd_panel_dpi.c
@@ -15,6 +15,11 @@
 #include "esp_private/dw_gdma.h"
 #include "hal/color_hal.h"
 
+// Moybyte P4: dedicated DSI bridge underrun IRQ, raised above ESP-Hosted's
+// level-1 SDIO interrupt, and a hook the board counts each underrun through
+// (native/p4/moy_dsi).
+void moy_dsi_note_underrun(void) __attribute__((weak));
+
 typedef struct esp_lcd_dpi_panel_t esp_lcd_dpi_panel_t;
 
 static esp_err_t dpi_panel_del(esp_lcd_panel_t *panel);
@@ -114,6 +119,9 @@ void mipi_dsi_bridge_isr_handler(void *args)
         // it's too late to recover the display, so we just print an error message
         // as a hint to the user that he should optimize the memory bandwidth (with AXI-ICM)
         ESP_DRAM_LOGE(TAG, "can't fetch data from external memory fast enough, underrun happens");
+        if (moy_dsi_note_underrun) {
+            moy_dsi_note_underrun();
+        }
     }
     if (intr_status & MIPI_DSI_BRG_LL_EVENT_VSYNC) {
         if (dpi_panel->on_vsync) {
@@ -146,6 +154,10 @@ static esp_err_t dpi_panel_create_dma_link(esp_lcd_dpi_panel_t *dpi_panel)
         },
         .flow_controller = DW_GDMA_FLOW_CTRL_SELF, // DMA as the flow controller
         .chan_priority = 1,
+        // Restarting this full-frame transfer is scan-out critical. Keep its
+        // ISR above the level-1 SDIO interrupt used by ESP-Hosted, otherwise a
+        // BLE connection burst can miss the panel's vertical blanking window.
+        .intr_priority = 3,
     };
     ESP_RETURN_ON_ERROR(dw_gdma_new_channel(&dma_alloc_config, &dma_chan), TAG, "create DMA channel failed");
     dpi_panel->dma_chan = dma_chan;
@@ -292,7 +304,9 @@ esp_err_t esp_lcd_new_panel_dpi(esp_lcd_dsi_bus_handle_t bus, const esp_lcd_dpi_
 #endif
 
     // install interrupt service
-    int isr_flags = ESP_INTR_FLAG_LOWMED;
+    // Level 3 lets the underrun diagnostic fire even while the hosted
+    // controller is servicing its level-1 SDIO IRQ.
+    int isr_flags = ESP_INTR_FLAG_LEVEL3;
 #if CONFIG_LCD_DSI_ISR_CACHE_SAFE
     isr_flags |= ESP_INTR_FLAG_IRAM;
 #endif
